# Multi-stage production Dockerfile for Grahvani Dramatiq Worker
FROM python:3.12-slim AS builder

# Install system build dependencies for pyswisseph C extension
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN pip install poetry==1.8.3

WORKDIR /build

# Copy dependency files first (Docker layer cache optimization)
COPY pyproject.toml poetry.lock* ./

# Install runtime dependencies only (no dev tools)
RUN poetry config virtualenvs.create false \
    && poetry install --only main --no-interaction --no-ansi

# ----------------------------------------------------------------
FROM python:3.12-slim AS runtime

RUN apt-get update && apt-get install -y \
    libpq-dev \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf2.0-0 \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /app

# Copy application source code
COPY . .

# Worker doesn't expose a port natively, but App Runner requires a port for health checks.
# Dramatiq doesn't provide an HTTP server by default. 
# A lightweight HTTP server is needed if App Runner health checks are enforced, 
# but for now we just specify the worker command.
EXPOSE 8080

# Default startup: dramatiq worker
CMD ["dramatiq", "app.tasks.worker", "--processes", "2", "--threads", "4"]
