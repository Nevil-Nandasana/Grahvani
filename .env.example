# ==============================================================
# Grahvani — Environment Variables Template
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ==============================================================

# ----- Application -----
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=changeme_32_char_random_secret_here
DEBUG=true
LOG_LEVEL=INFO

# ----- PostgreSQL Database -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=grahvani
POSTGRES_USER=grahvani_user
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://grahvani_user:changeme_strong_password@localhost:5432/grahvani

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ----- Firebase Admin SDK -----
# Path to your downloaded Firebase service account JSON key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ----- Google AI (Gemini Flash + Embeddings) -----
GEMINI_API_KEY=your-google-gemini-api-key-here

# ----- Google Places API (for geocoding in profile creation) -----
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# ----- Razorpay Billing -----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=changeme_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=changeme_webhook_secret

# ----- Apple App Store -----
APPLE_BUNDLE_ID=com.grahvani.app
APPLE_SHARED_SECRET=your-apple-shared-secret

# ----- Google Play Billing -----
GOOGLE_PLAY_PACKAGE_NAME=com.grahvani.app
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./google-play-service-account.json

# ----- AWS (Production Only) -----
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=grahvani-private-assets
AWS_RDS_HOST=your-rds-endpoint.rds.amazonaws.com
